APP_NAME="Nexus AI Search Engine Platform"
DEBUG=True
SECRET_KEY="nexus_super_secret_jwt_key_2026_change_in_prod"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Secret API Keys (Stored 100% Server-Side in Environment Variables)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"
GEMINI_API_KEY="your_gemini_api_key_here"

# Databases & Cache
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/nexus_db"
REDIS_URL="redis://localhost:6379/0"

# Next.js Frontend Config
NEXT_PUBLIC_BACKEND="http://localhost:8000"
NEXTAUTH_SECRET="nexus_super_secret_jwt_key_2026_change_in_prod"
NEXTAUTH_URL="http://localhost:3000"
